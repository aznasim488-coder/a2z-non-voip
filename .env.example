# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Your Railway app URL — set after first deploy (Settings → Domains)
PUBLIC_BASE_URL=https://YOUR-APP.up.railway.app

# ─── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather  e.g. 123456789:AABBccDDeeFF...
TELEGRAM_BOT_TOKEN=

# "polling" = local dev only. Use "webhook" for Railway/production.
BOT_MODE=webhook

# Random string min 16 chars — Telegram will call:
# POST https://YOUR-APP.up.railway.app/webhooks/telegram/<this value>
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram user IDs that get the /admin menu
# Find your ID via @userinfobot
ADMIN_TELEGRAM_IDS=

# ─── PVADeals upstream ─────────────────────────────────────────────────────────
# Your reseller API key from pvadeals.com dashboard
PVADEALS_API_KEY=
PVADEALS_BASE_URL=https://prod-v3.pvadeals.com

# Random string min 16 chars. Set this same value in PVADeals webhook settings.
# PVADeals will POST to: https://YOUR-APP.up.railway.app/webhooks/pvadeals/<this value>
PVADEALS_WEBHOOK_SECRET=

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://XXXXXXXX.supabase.co

# Settings → API → service_role (secret key — NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=

# ─── NOWPayments crypto top-ups (optional) ─────────────────────────────────────
# Leave blank if you don't use crypto payments — both must be set or neither
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
